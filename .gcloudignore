# .gcloudignore
# Use this to prevent large or sensitive files from being uploaded to Google Cloud Build.

# Python
**/.venv/
**/__pycache__/
**/*.pyc
**/*.pyo
**/.pytest_cache/

# IDE
.vscode/
.idea/
**/.DS_Store

# Git
.git/
.gitignore

# Misc
*.log
*.md

# Frontend specific
**/node_modules
**/.next

# Large data files
**/*.csv
**/*.parquet
**/*.pkl

# Overrides to include required files
!.env
!README.md