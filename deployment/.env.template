# Deployment Environment Variables Template
# Copy this file to .env and fill in the values

# AI Model Configuration
MODEL_NAME=gemini-2.5-flash
GOOGLE_GENAI_USE_VERTEXAI=1

# Google Cloud Project Configuration
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# BigQuery Configuration
BIGQUERY_DATASET=your_dataset_name
BIGQUERY_TABLE=your_table_name

# Service Account for Cloud Run
SERVICE_ACCOUNT=your-service-account@your-project-id.iam.gserviceaccount.com

# Application Name
SERVICE_NAME=my_monolithic_app

# (Optional) Remote Agent URL for standalone frontend deployment
# REMOTE_AGENT_URL=https://your-backend-service-url.a.run.app
